{
  "name": "dich-vu-oi",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @dichvuoi/web",
    "dev:api": "npm run start:dev -w @dichvuoi/api",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "build": "npm run build -w @dichvuoi/api && npm run build -w @dichvuoi/web",
    "db:generate": "npm run prisma:generate -w @dichvuoi/api",
    "db:push": "npm run prisma:push -w @dichvuoi/api",
    "db:seed": "npm run prisma:seed -w @dichvuoi/api"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
