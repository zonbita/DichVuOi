# Neon / Postgres (bắt buộc trên Vercel — không dùng SQLite)
# Ví dụ Neon: postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://neondb_owner:PASSWORD_MOI@ep-weathered-cherry-azbzcr2u-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

PORT=3001

# Production: https://dich-vu-oi.vercel.app
# Nhiều origin: phân tách bằng dấu phẩy. Để trống / * = reflect origin.
CORS_ORIGIN="http://localhost:5173"

JWT_SECRET="change-me-in-production"

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Tuỳ chọn: thư mục upload (Vercel mặc định /tmp/dichvuoi-uploads)
# UPLOADS_DIR=
