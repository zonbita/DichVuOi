# Neon / Postgres (bắt buộc trên Vercel — không dùng SQLite)
# Ví dụ Neon: postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
#
# Dev chậm (hồ sơ /api/partners/public…)? Dùng Postgres local gần máy thay Neon xa:
#   DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/dichvuoi"
# Rồi: npm run prisma:push -w @dichvuoi/api && npm run prisma:seed -w @dichvuoi/api
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

PORT=3001

# Production: https://dich-vu-oi.vercel.app
# Nhiều origin: phân tách bằng dấu phẩy. Để trống / * = reflect origin.
CORS_ORIGIN="http://localhost:5173"

JWT_SECRET="change-me-in-production"
# Production: bắt buộc secret ≥16 ký tự (không dùng fallback).
# VIETQR_INTENT_SECRET="change-me-vietqr-hmac"

# Mock nạp ví / VietQR confirm / xác minh NH tự confirm.
# Mặc định: bật ngoài production; tắt trên production.
# Dev cần tắt: ALLOW_MOCK_PAYMENTS=0
# Prod demo (không khuyến nghị): ALLOW_MOCK_PAYMENTS=1
# ALLOW_MOCK_PAYMENTS=

# Google OAuth (Identity Services — cùng Client ID trên web VITE_GOOGLE_CLIENT_ID)
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web)
# Authorized JavaScript origins: http://localhost:5173 , https://dich-vu-oi.vercel.app
# GOOGLE_CLIENT_ID=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- SMS xác minh SĐT (eSMS Brandname CSKH) ---
# Dev mặc định: SMS_PROVIDER=mock → hiện key trên web, không gọi gateway.
# Production: đăng ký esms.vn → Brandname + template CSKH → điền key:
# SMS_PROVIDER=esms
# ESMS_API_KEY=
# ESMS_SECRET_KEY=
# ESMS_BRANDNAME=DichVuOi
# ESMS_SANDBOX=1
# Nội dung phải khớp template đã duyệt trên eSMS ({key} = TenUser-XXXXXX):
# ESMS_OTP_TEMPLATE=DichVuOi: Ma xac minh {key}. Het han 5 phut.
# ESMS_UNICODE=0

# --- Email OTP (rút ví) — Gmail App Password ---
# 1) Bật 2FA Google → https://myaccount.google.com/apppasswords → tạo "Mail"
# 2) Dán App Password 16 ký tự (không dùng mật khẩu Gmail thường)
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# EMAIL_FROM="DichVuOi <you@gmail.com>"   # tuỳ chọn; From vẫn là GMAIL_USER

# Tuỳ chọn: thư mục upload local (dev). Vercel không dùng disk bền.
# UPLOADS_DIR=

# Production (Vercel): bắt buộc Vercel Blob — Storage → Blob → copy token
# https://vercel.com/docs/storage/vercel-blob
# BLOB_READ_WRITE_TOKEN=
