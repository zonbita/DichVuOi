generator client {
  provider      = "prisma-client-js"
  // native = local Windows/macOS; rhel = Vercel Node runtime
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  PARTNER
  ADMIN
  MODERATOR
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  /** Người làm báo xong — chờ khách xác nhận / hết hạn / khiếu nại. Escrow vẫn HELD. */
  AWAITING_CONFIRM
  /** Có khiếu nại đang mở — ban kiểm duyệt quyết. Escrow vẫn HELD. */
  DISPUTED
  COMPLETED
  CANCELLED
}

/** Nguồn mục yêu cầu trên đơn. */
enum RequirementSource {
  SERVICE_INCLUDES
  CUSTOMER_NOTE
  MANUAL
}

/** Kết quả xử lý khiếu nại — ảnh hưởng escrow / trạng thái đơn. */
enum ComplaintResolutionAction {
  /** Chấp nhận phía khách → hoàn cọc. */
  REFUND
  /** Chấp nhận phía người làm / từ chối khiếu nại khách → giải ngân + hoàn thành. */
  RELEASE
  /** Hòa / làm lại → quay IN_PROGRESS. */
  RETRY_IN_PROGRESS
  /** Hòa → quay chờ xác nhận. */
  RETRY_AWAITING
  /** Chỉ ghi nhận / đang xử lý — không đổi escrow. */
  NONE
}

/** Escrow mock: giữ tiền trên sàn đến khi hoàn thành / hoàn hủy. */
enum PaymentStatus {
  UNPAID
  HELD
  RELEASED
  REFUNDED
}

enum WalletTransactionType {
  TOP_UP
  /** User rút VNĐ về STK ngân hàng (mock trừ ví). */
  WITHDRAW
  ESCROW_HOLD
  ESCROW_REFUND
  PARTNER_PAYOUT
  ADMIN_ADJUSTMENT
  /** Người làm đặt cọc 10% để ứng tuyển đơn mở. */
  APPLY_DEPOSIT
  /** Hoàn cọc ứng tuyển (không được chọn / hết hạn / hoàn thành). */
  APPLY_REFUND
  /** Tịch thu cọc ứng tuyển (no-show sau khi được chọn / bỏ SLA). */
  APPLY_FORFEIT
}

/** Trạng thái hồ sơ ứng tuyển đơn mở. */
enum ApplicationStatus {
  APPLIED
  SELECTED
  REJECTED
  WITHDRAWN
  REFUNDED
}

enum InvoiceStatus {
  PAID
  SETTLED
  REFUNDED
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  /** Null khi tài khoản chỉ đăng nhập bằng Google OAuth. */
  passwordHash   String?
  /** Google `sub` — unique khi đã liên kết OAuth. */
  googleId       String?         @unique
  fullName       String
  phone          String?
  /** Đã xác minh SĐT (OTP key một lần). */
  phoneVerified  Boolean         @default(false)
  /** Key OTP một lần: TenUser-123456 — xoá sau khi dùng. */
  phoneOtpKey    String?
  phoneOtpExpiresAt DateTime?
  /** Đã xác minh email (OTP Resend) — hoặc Google email_verified. */
  emailVerified  Boolean         @default(false)
  emailOtpCode   String?
  emailOtpExpiresAt DateTime?
  /** Email đang chờ OTP (cho phép gắn/đổi email khi xác minh rút tiền). */
  emailPending   String?
  role           Role            @default(CUSTOMER)
  /** Số dư ví nội bộ, đơn vị VNĐ (số nguyên). */
  walletBalance  Int             @default(0)
  /** TK nhận khi rút ví (khách / người làm). */
  bankBin        String?
  bankCode       String?
  bankName       String?
  bankAccountNo  String?
  bankAccountName String?
  bankVerified   Boolean         @default(false)
  /** OTP email xác minh STK trước khi rút (khi chưa emailVerified). */
  bankVerifyOtpCode String?
  bankVerifyOtpExpiresAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  partnerProfile  PartnerProfile?
  customerBookings Booking[]     @relation("CustomerBookings")
  partnerBookings  Booking[]     @relation("PartnerBookings")
  bookingMessages  BookingMessage[]
  reviewsGiven     Review[]      @relation("ReviewsGiven")
  reviewsReceived  Review[]      @relation("ReviewsReceived")
  favoritePartners PartnerFavorite[] @relation("CustomerFavorites")
  favoritedBy      PartnerFavorite[] @relation("PartnerFavoritedBy")
  complaintsFiled  Complaint[]       @relation("ComplaintsFiled")
  complaintsAgainst Complaint[]      @relation("ComplaintsAgainst")
  complaintsTarget  Complaint[]      @relation("ComplaintsTarget")
  complaintsResolved Complaint[]     @relation("ComplaintsResolved")
  reputationPeriods PartnerReputationPeriod[]
  walletTransactions WalletTransaction[]
  customerInvoices Invoice[]         @relation("CustomerInvoices")
  partnerInvoices Invoice[]          @relation("PartnerInvoices")
  bookingApplications BookingApplication[]
  supportThreadsAsCustomer SupportThread[] @relation("SupportCustomer")
  supportThreadsAssigned   SupportThread[] @relation("SupportAssignee")
  supportMessages          SupportMessage[]
}

/** Khách lưu người làm quen — hỗ trợ thuê lại / cá nhân hóa trang chủ. */
model PartnerFavorite {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation("CustomerFavorites", fields: [userId], references: [id], onDelete: Cascade)
  partnerUserId  String
  partnerUser    User     @relation("PartnerFavoritedBy", fields: [partnerUserId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([userId, partnerUserId])
  @@index([userId, createdAt])
  @@index([partnerUserId])
}

model PartnerProfile {
  id          String           @id @default(cuid())
  userId      String           @unique
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline    String?
  bio         String?
  city        String?          @default("Hồ Chí Minh")
  /** Quận / khu vực phục vụ — chuỗi phân tách bằng dấu phẩy. */
  districts   String?
  ratingAvg   Float            @default(0)
  ratingCount Int              @default(0)
  /** Cấp độ người làm (1–100). Chỉ áp dụng khi có hồ sơ Partner. */
  level       Int              @default(1)
  /** Tổng giây online tích lũy (WS connect + heartbeat). */
  onlineSeconds Int            @default(0)
  /** Lần cuối còn online (heartbeat / flush disconnect). */
  lastOnlineAt DateTime?
  isVerified  Boolean          @default(false)
  /** Đã xác minh số điện thoại (OTP / vận hành). */
  phoneVerified Boolean        @default(false)
  /** Đã xác minh tài khoản ngân hàng nhận payout. */
  bankVerified Boolean         @default(false)
  /** Tên ngân hàng (VD: VCB, MB). */
  bankName    String?
  /** Số tài khoản nhận payout. */
  bankAccountNo String?
  /** Tên chủ tài khoản. */
  bankAccountName String?
  /** OTP SMS mock (dev) — xoá sau khi xác minh. */
  phoneOtpCode String?
  phoneOtpExpiresAt DateTime?
  /** Intent VietQR mock để xác minh NH. */
  bankVerifyIntentId String?
  bankVerifyExpiresAt DateTime?
  /** Ảnh đại diện người làm (URL). */
  avatarUrl   String?
  /** Gallery portfolio — JSON array URL ảnh (3–6), vd. ["https://..."]. */
  galleryJson String?
  /** Tag kỹ năng / nghề — JSON array string, vd. ["điện lạnh","điều hòa"]. */
  skillsJson  String?
  /** Đang nhận việc hay tạm nghỉ. */
  acceptingJobs Boolean        @default(true)
  /** Cách làm việc: "onsite", "online", hoặc "onsite,online". */
  workModes   String?          @default("onsite")
  /** Thời gian phản hồi ước tính (phút). */
  responseMinutes Int          @default(30)
  offerings   PartnerService[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model PartnerService {
  id               String         @id @default(cuid())
  partnerProfileId String
  partnerProfile   PartnerProfile @relation(fields: [partnerProfileId], references: [id], onDelete: Cascade)
  serviceId        String
  service          Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  price            Int?
  headline         String?
  experienceYears  Int            @default(0)
  /** Bao gồm gì khi thuê (văn bản ngắn). */
  includes         String?
  /** Không bao gồm gì. */
  excludes         String?
  /** Ghi chú phạm vi: «Nội thành HN», «Online Zalo/Discord». */
  coverageNote     String?
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([partnerProfileId, serviceId])
  @@index([serviceId])
}

model ServiceGroup {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  icon        String?
  sortOrder   Int        @default(0)
  isFeatured  Boolean    @default(false)
  /** Nhóm có ít nhất một nghề có thể làm online (metadata tổng quát). */
  supportsOnline Boolean @default(false)
  categories  Category[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Category {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  description String?
  groupId     String
  group       ServiceGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  services    Service[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([groupId])
}

model Service {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  /** Giá mặc định khi tạo đơn / fallback chào giá partner. */
  basePrice   Int
  /** Giá tham khảo thị trường — cận dưới (₫). */
  priceMin    Int       @default(0)
  /** Giá tham khảo thị trường — cận trên (₫). */
  priceMax    Int       @default(0)
  unit        String    @default("giờ")
  durationMin Int       @default(60)
  /** Nghề có thể được thực hiện hoàn toàn online. */
  supportsOnline Boolean @default(false)
  isActive    Boolean   @default(true)
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  bookings    Booking[]
  partners    PartnerService[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([categoryId])
}

model Booking {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation("CustomerBookings", fields: [userId], references: [id], onDelete: Cascade)
  partnerId     String?
  partner       User?         @relation("PartnerBookings", fields: [partnerId], references: [id], onDelete: SetNull)
  serviceId     String
  service       Service       @relation(fields: [serviceId], references: [id])
  address       String
  scheduledAt   DateTime
  note          String?
  budgetMin     Int?
  budgetMax     Int?
  /**
   * % cọc ứng tuyển người làm yêu cầu trên totalPrice (basis points).
   * 0 = miễn cọc; 1000 = 10%; 10000 = 100%. Chủ thuê set khi đăng đơn mở.
   */
  applyDepositBps Int         @default(1000)
  status        BookingStatus @default(PENDING)
  totalPrice    Int
  customerName   String
  customerPhone String
  /** Escrow mock — thanh toán giữ trên sàn. */
  paymentStatus PaymentStatus @default(UNPAID)
  /** Hoa hồng sàn % (vd. 15). */
  commissionBps Int           @default(1500)
  commissionAmount Int        @default(0)
  partnerPayout    Int        @default(0)
  paidAt        DateTime?
  releasedAt    DateTime?
  refundedAt    DateTime?
  /** Hết hạn cửa sổ chờ xác nhận (auto hoàn thành nếu không khiếu nại) — mock/cron sau. */
  confirmDeadlineAt DateTime?
  /** Hết hạn ghép người làm (đơn PENDING mở) — mặc định +7 ngày khi tạo. */
  matchingDeadlineAt DateTime?
  /**
   * Hết hạn SLA phản hồi sau khi được chọn (CONFIRMED).
   * Quá hạn mà chưa IN_PROGRESS → tịch thu cọc ứng tuyển + mở lại hàng chờ.
   */
  responseDeadlineAt DateTime?
  /** Ghi chú kết quả tranh chấp công khai cho 2 bên. */
  disputeResultNote String?
  /** % nghiệm thu do 1 bên đề xuất khi chờ xác nhận (1..100). */
  settlementPercent Int?
  /** Ai đang là bên đề xuất % nghiệm thu. */
  settlementProposedBy Role?
  /** Thời điểm khách thuê bấm đồng ý % hiện tại. */
  customerSettlementApprovedAt DateTime?
  /** Thời điểm người làm bấm đồng ý % hiện tại. */
  partnerSettlementApprovedAt DateTime?
  /** Đã chốt thanh toán theo % (hai bên đồng ý). */
  settlementResolvedAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  messages      BookingMessage[]
  reviews       Review[]
  complaints    Complaint[]
  requirements  BookingRequirement[]
  applications  BookingApplication[]
  walletTransactions WalletTransaction[]
  invoice       Invoice?

  @@index([userId])
  @@index([partnerId])
  @@index([serviceId])
  @@index([status])
  @@index([paymentStatus])
  @@index([scheduledAt])
  @@index([matchingDeadlineAt])
  @@index([responseDeadlineAt])
}

/** Người làm ứng tuyển đơn mở — cọc theo applyDepositBps của đơn. */
model BookingApplication {
  id            String            @id @default(cuid())
  bookingId     String
  booking       Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  partnerId     String
  partner       User              @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  /** Số tiền cọc ứng tuyển (theo applyDepositBps × totalPrice). */
  depositAmount Int
  /** HELD khi đang ứng tuyển / được chọn; REFUNDED khi hoàn; RELEASED nếu tịch thu (hiếm). */
  depositStatus PaymentStatus     @default(HELD)
  status        ApplicationStatus @default(APPLIED)
  note          String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([bookingId, partnerId])
  @@index([bookingId, status])
  @@index([partnerId, createdAt])
}

/** Sổ cái ví VNĐ — amount dương là tiền vào, âm là tiền ra. */
model WalletTransaction {
  id           String                @id @default(cuid())
  userId       String
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingId    String?
  booking      Booking?              @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  type         WalletTransactionType
  amount       Int
  balanceAfter Int
  description  String
  /** Khóa idempotency, vd. hold:<bookingId>, refund:<bookingId>. */
  reference    String                @unique
  createdAt    DateTime              @default(now())

  @@index([userId, createdAt])
  @@index([bookingId])
}

/** Hóa đơn VNĐ chụp lại thông tin tại thời điểm đặt cọc. */
model Invoice {
  id               String        @id @default(cuid())
  invoiceNumber    String        @unique
  bookingId        String        @unique
  booking          Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerId       String
  customer         User          @relation("CustomerInvoices", fields: [customerId], references: [id], onDelete: Cascade)
  partnerId        String?
  partner          User?         @relation("PartnerInvoices", fields: [partnerId], references: [id], onDelete: SetNull)
  customerName     String
  serviceName      String
  subtotal         Int
  commissionAmount Int           @default(0)
  partnerPayout    Int           @default(0)
  currency         String        @default("VND")
  status           InvoiceStatus @default(PAID)
  issuedAt         DateTime      @default(now())
  settledAt        DateTime?
  refundedAt       DateTime?
  updatedAt        DateTime      @updatedAt

  @@index([customerId, issuedAt])
  @@index([partnerId, issuedAt])
  @@index([status])
}

/** Mục yêu cầu (checklist) trên đơn — tick khách = xác nhận bàn giao. */
model BookingRequirement {
  id                 String            @id @default(cuid())
  bookingId          String
  booking            Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  content            String
  sortOrder          Int               @default(0)
  source             RequirementSource @default(SERVICE_INCLUDES)
  /** Người làm đánh dấu «tôi đã làm» (gợi ý, không tính bàn giao). */
  partnerDone        Boolean           @default(false)
  partnerDoneAt      DateTime?
  /** Khách tích «đã nhận / đã xong» — xác nhận bàn giao. */
  customerConfirmed  Boolean           @default(false)
  customerConfirmedAt DateTime?
  evidenceUrl        String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([bookingId, sortOrder])
}

/** Chat theo đơn — kênh liên hệ chính thức (chống bỏ sàn). Body bị lọc SĐT/Zalo/email. */
model BookingMessage {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body      String
  /** true nếu hệ thống đã ẩn PII trong body. */
  redacted  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([bookingId, createdAt])
  @@index([senderId])
}

/** Trạng thái hội thoại hỗ trợ khách ↔ admin/moderator. */
enum SupportThreadStatus {
  OPEN
  CLOSED
}

/** Chat hỗ trợ kỹ thuật — độc lập với chat theo đơn. */
model SupportThread {
  id            String              @id @default(cuid())
  customerId    String
  customer      User                @relation("SupportCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  assigneeId    String?
  assignee      User?               @relation("SupportAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  status        SupportThreadStatus @default(OPEN)
  lastMessageAt DateTime            @default(now())
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  messages      SupportMessage[]

  @@index([customerId, status])
  @@index([assigneeId])
  @@index([lastMessageAt])
}

model SupportMessage {
  id        String        @id @default(cuid())
  threadId  String
  thread    SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body      String
  redacted  Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@index([threadId, createdAt])
  @@index([senderId])
}

/** Đánh giá hai chiều sau COMPLETED (mỗi bên 1 lần / đơn). */
model Review {
  id         String   @id @default(cuid())
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromUserId String
  fromUser   User     @relation("ReviewsGiven", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User     @relation("ReviewsReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  @@unique([bookingId, fromUserId])
  @@index([toUserId])
  @@index([bookingId])
}

/** Khiếu nại theo đơn — trừ điểm uy tín khi Admin xác minh đúng. */
enum ComplaintStatus {
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

model Complaint {
  id               String          @id @default(cuid())
  bookingId        String
  booking          Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  reporterUserId   String
  reporter         User            @relation("ComplaintsFiled", fields: [reporterUserId], references: [id], onDelete: Cascade)
  /** Partner của đơn (uy tín / tra cứu). */
  partnerUserId    String
  partner          User            @relation("ComplaintsAgainst", fields: [partnerUserId], references: [id], onDelete: Cascade)
  /** Bên bị khiếu nại (khách hoặc người làm). */
  againstUserId    String?
  against          User?           @relation("ComplaintsTarget", fields: [againstUserId], references: [id], onDelete: SetNull)
  category         String
  description      String
  /** JSON string[] id mục checklist gắn khiếu nại. */
  requirementIdsJson String?
  /** Ghi chú / link bằng chứng (ảnh, video, chat). */
  evidenceNote     String?
  status           ComplaintStatus @default(SUBMITTED)
  /** Điểm trừ uy tín partner khi VERIFIED (chấp nhận phía khách). */
  deductionPoints  Int?
  adminNote        String?
  resolutionAction ComplaintResolutionAction?
  resolvedAt       DateTime?
  resolvedByUserId String?
  resolvedBy       User?           @relation("ComplaintsResolved", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  ledgerEntries    ReputationLedgerEntry[]

  @@index([partnerUserId, status])
  @@index([reporterUserId])
  @@index([againstUserId])
  @@index([bookingId])
  @@index([status, createdAt])
}

/** Chu kỳ uy tín theo năm kể từ ngày tạo tài khoản partner (mặc định 1000 điểm/chu kỳ). */
model PartnerReputationPeriod {
  id              String   @id @default(cuid())
  partnerUserId   String
  partnerUser     User     @relation(fields: [partnerUserId], references: [id], onDelete: Cascade)
  /** 0 = năm đầu từ createdAt, 1 = năm thứ hai, … */
  periodIndex     Int
  startingPoints  Int      @default(1000)
  currentPoints   Int      @default(1000)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  ledgerEntries   ReputationLedgerEntry[]

  @@unique([partnerUserId, periodIndex])
  @@index([partnerUserId])
}

model ReputationLedgerEntry {
  id          String                  @id @default(cuid())
  periodId    String
  period      PartnerReputationPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  delta       Int
  reason      String
  complaintId String?
  complaint   Complaint?              @relation(fields: [complaintId], references: [id], onDelete: SetNull)
  createdAt   DateTime                @default(now())

  @@index([periodId, createdAt])
}
