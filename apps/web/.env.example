# Local: để trống — Vite proxy /api và /socket.io → localhost:3001
# VITE_API_URL=http://localhost:3001

# Production (Vercel Project Settings → Environment Variables → Redeploy):
# VITE_API_URL=https://dich-vu-oi-api.vercel.app

# Google Maps — Places + Maps JavaScript API
# VITE_GOOGLE_MAPS_API_KEY=

# Google Sign-In (OAuth 2.0 Web Client ID — cùng giá trị GOOGLE_CLIENT_ID trên API)
# VITE_GOOGLE_CLIENT_ID=
